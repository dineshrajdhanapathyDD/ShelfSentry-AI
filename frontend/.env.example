# Base URL of the ShelfSentry API the frontend talks to.
#
# Local development: defaults to http://localhost:8000 when unset
# (see src/api/config.ts). Note: this repo ships the backend as AWS Lambda
# handlers + a framework-agnostic handler set; a standalone local HTTP server
# is not included, so local UI development typically runs against the mocked
# API client used in tests, or against a deployed API.
#
# AWS mode: set this to the stack's CloudFormation "ApiUrl" output (the API
# Gateway HTTP API endpoint). It already targets the $default stage, so the
# client's paths (/inspections, /evaluations, ...) resolve directly. Example:
#   VITE_API_BASE_URL=https://abc123.execute-api.us-east-1.amazonaws.com
#
# This value is NOT a secret (it is a public HTTPS endpoint). Do not put AWS
# credentials here; the browser never holds AWS credentials.
VITE_API_BASE_URL=http://localhost:8000